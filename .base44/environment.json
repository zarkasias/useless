{
  "previewPort": 3000,
  "healthPath": "/",
  "startCommand": "docker compose -f docker-compose.base44.yml up -d",
  "secrets": [
    { "name": "NEXT_PUBLIC_SUPABASE_URL", "description": "Supabase project URL", "requiredAtBoot": true },
    { "name": "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY", "description": "Supabase publishable/anon key", "requiredAtBoot": true },
    { "name": "SUPABASE_SERVICE_ROLE_KEY", "description": "Supabase service role key (server-side only)", "requiredAtBoot": false }
  ]
}
